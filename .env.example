# ============================================================================
#  FaceVault configuration
#  Copy this file to `.env` (same folder) and fill in your own values.
#  `.env` is git-ignored: never commit real credentials.
#  Real environment variables, if set, take priority over this file.
# ============================================================================

# --- Keyring -----------------------------------------------------------------
# Unlocks backend/instance/keyring.enc (scrypt -> AES-256-GCM). Use a long random value.
# Changing it later? Run `python backend/change_passphrase.py` first, or the keyring stays locked.
BFE_MASTER_PASSPHRASE=change-me-to-a-long-random-passphrase

# --- Super administrator ------------------------------------------------------
# The only account that can sign in. Everyone else can only use the public Verify page.
BFE_SUPER_ADMIN=you@example.com
# Applied on every start-up: edit it here and restart to change the password (min 10 characters).
BFE_ADMIN_PASSWORD=change-me-please

# --- Face matching -----------------------------------------------------------
# Maximum face distance that counts as a match. Lower = stricter (fewer false accepts).
BFE_MATCH_THRESHOLD=0.5

# --- Sessions ------------------------------------------------------------------
BFE_JWT_TTL_MINUTES=30

# --- Storage (optional) -------------------------------------------------------
# Where the database and keyring live. Defaults to backend/instance.
# BFE_DATA_DIR=C:\path\to\facevault-data
